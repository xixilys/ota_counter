# Copy to .env next to docker-compose.yml.
# 0.0.0.0 exposes the port; keep 127.0.0.1 when using an Nginx reverse proxy.
OTA_SYNC_BIND=0.0.0.0
# Optional. If empty, the server generates a token in /data/token; never logs it.
OTA_SYNC_TOKEN=

# Required only for face upload links. Full public origin + proxy prefix.
OTA_SYNC_PUBLIC_BASE_URL=
